---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

import type { DocsEntry } from '../lib/content';
import XPTable from './XPTable';
import NPCList from './NPCList';
import NPCStats from './NPCStats';

const { ['components']: _, ...safeProps } = Astro.props;

const { entry } = Astro.locals.starlightRoute;

const data = entry.data as DocsEntry['data'];

let pageType = "default";

if (entry.id.startsWith("codex/session/"))
    pageType = "session";

else if (entry.id.startsWith("codex/npc/"))
    pageType = "npc";

---

{ pageType === "npc" && (
  <>
  <NPCStats id={entry.id} data={data} />
  </>
)}

<Default {...safeProps}>
  <slot />
</Default>

{
  pageType === "session" && (
    <>
      <NPCList npcs={data?.npcs || []} />
      <XPTable
        encounters={data?.encounters || []}
        xp={data?.xp || { total: 0, each: 0, players: 0 }}
        treasureItems={data?.treasureItems || []}
        treasureTotal={data?.treasureTotal || 0}
        client:load
      />
    </>
  )
}
