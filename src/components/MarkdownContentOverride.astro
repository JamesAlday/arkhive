---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import XPTable from './XPTable';
import NPCList from './NPCList';

const { ['components']: _, ...safeProps } = Astro.props;

const { entry } = Astro.locals.starlightRoute;

const data = entry.data as any;

let pageType = "default";

if (entry.id.startsWith("codex/session/"))
    pageType = "session";

else if (entry.id.startsWith("codex/npc/"))
    pageType = "npc";

---
<Default {...safeProps}>
  <slot />
</Default>

{
  pageType === "session" && (
    <>
      <NPCList npcs={data?.npcs} />
      <XPTable
        encounters={data?.encounters || null}
        xp={data?.xp || null}
        treasureItems={data?.treasureItems || []}
        treasureTotal={data?.treasureTotal || 0}
        client:load
      />
    </>
  )
}