---
import ScifiLayout from "../layouts/ScifiLayout.astro";
import AppShell from "../components/shell/AppShell.astro";
import AppNav from "../components/shell/AppNav.astro";
import Panel from "../components/core/Panel.astro";
import Text from "../components/core/Text.astro";
import HudReadout from "../components/hud/HudReadout.astro";

import SessionExperience from "../components/charts/SessionExperience.tsx";
import RunningXPTable from "../components/charts/RunningXP.tsx";
import RecentXP from "../components/charts/RecentXP.tsx";
import SessionsPerLevel from "../components/charts/SessionsPerLevel.tsx";

import { getSessionXPSeries, getRunningXP, getSessionsPerLevelSeries, getRecentXPSeries } from "../lib/sessions";
import { getSessionPages } from '../lib/content';

const sessionPages = await getSessionPages();
const sessionXP = getSessionXPSeries(sessionPages);
const runningXP = getRunningXP(sessionPages);
const recentXP = getRecentXPSeries(runningXP);
const sessionsPerLevel = getSessionsPerLevelSeries(sessionPages);
---

<ScifiLayout title="Dashboard">
  <AppShell>
    <AppNav />
    <header class="space-y-2">
      <Text variant="label" class="text-sf-primary">Telemetry</Text>
      <Text variant="heading" glow class="max-w-2xl text-xl sm:text-2xl">Dashboard</Text>
      <p class="max-w-3xl text-sm text-sf-muted">
        Recent experience and session data for the campaign, including XP, encounters, and treasure.
      </p>
    </header>

    <Panel variant="primary" glow layer="raised" class="mt-6">
      <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
          <Text variant="heading" as="h2" class="!text-base">Running Experience</Text>
          <Text variant="label" class="mt-1 text-sf-dim">Open-Meteo hourly + static ingest snapshot</Text>
        </div>
        <div class="pointer-events-none hidden text-right sm:block">
          <HudReadout align="right">
            <span slot="label">Link</span>
            nominal
          </HudReadout>
        </div>
      </div>
      <div>
        <RunningXPTable xp={runningXP} client:load />
      </div>
      <div>
        <div><RecentXP xp={recentXP} client:load /></div>
      </div>
      <div style="display: flex; gap: 20px;">
        <div><SessionExperience xp={sessionXP} client:load /></div>
        <SessionsPerLevel xp={sessionsPerLevel} client:load />
      </div>
    </Panel>
  </AppShell>
</ScifiLayout>
